{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Converte Facil",
  "version": "0.1.0",
  "identifier": "app.convertefacil.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Converte Facil",
        "width": 920,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$TEMP/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$PICTURE/**",
          "$VIDEO/**",
          "$PUBLIC/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$LOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Converte Facil",
    "copyright": "Copyright © 2026 MarcosLorejan",
    "shortDescription": "Convert images and PDFs on your computer",
    "longDescription": "Converte Facil converts images and PDFs locally. Files never leave your computer.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecars/imagemagick/": "sidecars/imagemagick/",
      "sidecars/ghostscript/": "sidecars/ghostscript/",
      "../third-party/": "third-party/",
      "../scripts/install-libreoffice-setup.ps1": "install-libreoffice-setup.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "PortugueseBR"],
        "displayLanguageSelector": true,
        "startMenuFolder": "Converte Facil",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
